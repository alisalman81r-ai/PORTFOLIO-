# Contact form configuration.
#
# Copy to `.env.local` for local development, and set the same values in your
# host's dashboard for production (Vercel: Project → Settings → Environment
# Variables).
#
# NOTHING HERE IS PREFIXED `VITE_`, AND THAT IS DELIBERATE.
# Vite inlines every `VITE_`-prefixed variable into the browser bundle as plain
# text. These are all read inside serverless functions, which never ship to the
# browser. Prefixing any of them would publish it — a `VITE_RESEND_API_KEY`
# would let anyone on the internet send email as you, and a
# `VITE_SUPABASE_SERVICE_ROLE_KEY` would hand over the whole database.
#
# `.env.local` is already covered by .gitignore. Never commit real values.

# ── Email: required ────────────────────────────────────────────────────────
# Without both of these the endpoint returns 500 rather than pretending to send.

# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered. This is the one to change when your address
# changes — nothing else needs touching.
CONTACT_TO_EMAIL=you@yourdomain.com

# ── Email: optional ────────────────────────────────────────────────────────

# The From address. Must be on a domain verified in Resend — sending as the
# visitor's address instead would fail SPF and land in spam.
# Until you have verified a domain, Resend's shared sender works for testing:
#   Portfolio <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Your Name <hello@yourdomain.com>

# Signed on the confirmation email, and used in its footer.
CONTACT_OWNER_NAME=Your Name
SITE_URL=https://yourdomain.com

# The promise made in the confirmation email. Keep it one you can keep.
CONTACT_REPLY_WITHIN=two working days

# Set to `false` to stop sending confirmations to the visitor.
CONTACT_SEND_CONFIRMATION=true

# ── Database: optional ─────────────────────────────────────────────────────
# Without these the form still works — enquiries are emailed but not stored.
# Run `api/schema.sql` first.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# The SERVICE ROLE key, not the anon key. It bypasses row-level security, which
# is correct for a server-side insert and catastrophic in a browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Only if you renamed the table.
SUPABASE_TABLE=contact_enquiries

# ── Rate limiting: optional ────────────────────────────────────────────────
# Without these the limiter uses per-instance memory, which stops the common
# case but not a distributed flood — see api/_lib/rateLimit.js. Set these before
# the form is linked anywhere that attracts attention.

UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# Requests per window, per IP.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
